---
import '../styles/global.css';
import { UI } from '../i18n/ui';
import { LANGS } from '../i18n/langs';

interface Props {
  titleKey?: string;
  descriptionKey?: string;
}

const {
  titleKey = 'meta.home.title',
  descriptionKey = 'meta.home.desc',
} = Astro.props;

const title = UI.en[titleKey];
const description = UI.en[descriptionKey];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Odys Travel, travel scratch map, photo map, iOS travel tracker, offline world map, travel timeline, private travel journal" />
    <meta name="author" content="Dmitry Sinkevich" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://disin8.github.io/odys/" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Odys Travel" />
    <meta property="og:title" content="Odys Travel — Private On-Device Scratch Map for iOS" />
    <meta property="og:description" content="Find every country, region, and city you've visited in seconds. 100% offline, zero server uploads, pure privacy." />
    <link rel="icon" type="image/png" href="/odys/assets/images/app-icon.png" />
    <meta property="og:url" content="https://disin8.github.io/odys/" />
    <meta property="og:image" content="/assets/images/app-icon.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Odys Travel — Private Travel Scratch Map" />
    <meta name="twitter:description" content="Turn your photo metadata into an interactive world map. 34,000 offline cities, zero tracking." />
    <meta name="twitter:image" content="/assets/images/app-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Odys Travel",
      "operatingSystem": "iOS 18.0 or later",
      "applicationCategory": "TravelApplication",
      "author": {
        "@type": "Person",
        "name": "Dmitry Sinkevich"
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Private on-device travel scratch map and journey timeline generated from iPhone photo metadata without uploading any pictures to cloud servers."
    }
    </script>

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'light'; 
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body data-title-key={titleKey} data-desc-key={descriptionKey} class="antialiased selection:bg-[#FF8566]/20 selection:text-[#3B364F] min-h-screen text-[#221F2C] dark:text-[#F5F3FA] odys-mesh-bg transition-colors duration-500">
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
      <div class="absolute -top-32 -left-32 w-[34rem] h-[34rem] rounded-full bg-[var(--mesh-0)]/60 dark:bg-[var(--mesh-0)]/40 filter blur-[130px] ambient-glow-1"></div>
      <div class="absolute top-10 -right-32 w-[36rem] h-[36rem] rounded-full bg-[var(--mesh-2)]/60 dark:bg-[var(--mesh-2)]/40 filter blur-[150px] ambient-glow-2"></div>
      <div class="absolute bottom-20 -left-20 w-[30rem] h-[30rem] rounded-full bg-[var(--mesh-6)]/50 dark:bg-[var(--mesh-6)]/30 filter blur-[140px] ambient-glow-2"></div>
      <div class="absolute -bottom-20 -right-20 w-[32rem] h-[32rem] rounded-full bg-[var(--mesh-8)]/50 dark:bg-[var(--mesh-8)]/30 filter blur-[140px] ambient-glow-1"></div>
    </div>

    <slot />

    <script is:inline define:vars={{ UI, LANGS }}>
      function toggleTheme() {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      }
      window.toggleTheme = toggleTheme;

      const htmlLang = { en: 'en', ja: 'ja', zh: 'zh-Hans', ko: 'ko', ru: 'ru', de: 'de', es: 'es', fr: 'fr' };

      function matchLang(tag) {
        const primary = String(tag || '').toLowerCase().split('-')[0];
        if (primary === 'zh') return 'zh';
        return UI[primary] ? primary : null;
      }

      function detectLang() {
        const saved = localStorage.getItem('lang');
        if (UI[saved]) return saved;
        const list = navigator.languages?.length ? navigator.languages : [navigator.language];
        for (const tag of list) {
          const hit = matchLang(tag);
          if (hit) return hit;
        }
        return 'en';
      }

      let current = detectLang();

      function odysT(key) {
        const pack = UI[current] || UI.en;
        return pack[key] ?? UI.en[key] ?? '';
      }

      function closeLangMenu() {
        const list = document.getElementById('lang-list');
        const toggle = document.getElementById('lang-toggle');
        if (list) list.hidden = true;
        if (toggle) toggle.setAttribute('aria-expanded', 'false');
      }

      function odysApply() {
        document.documentElement.lang = htmlLang[current] || 'en';
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const value = odysT(el.getAttribute('data-i18n'));
          const attr = el.getAttribute('data-i18n-attr');
          if (attr) el.setAttribute(attr, value);
          else el.textContent = value;
        });
        document.querySelectorAll('[data-lang-panel]').forEach((el) => {
          el.hidden = el.getAttribute('data-lang-panel') !== current;
        });
        const pageTitle = document.body.dataset.titleKey;
        const pageDesc = document.body.dataset.descKey;
        if (pageTitle) document.title = odysT(pageTitle);
        const desc = document.querySelector('meta[name="description"]');
        if (desc && pageDesc) desc.setAttribute('content', odysT(pageDesc));
        const label = document.getElementById('lang-label');
        const meta = LANGS.find((item) => item.id === current);
        if (label && meta) label.textContent = meta.short;
        document.querySelectorAll('[data-lang-option]').forEach((btn) => {
          const on = btn.getAttribute('data-lang-option') === current;
          if (on) btn.setAttribute('aria-current', 'true');
          else btn.removeAttribute('aria-current');
          btn.classList.toggle('text-[#FF7A59]', on);
        });
        window.odysLang = current;
        document.dispatchEvent(new CustomEvent('odys-lang'));
      }

      function odysSetLang(lang) {
        current = UI[lang] ? lang : 'en';
        localStorage.setItem('lang', current);
        odysApply();
      }

      window.odysT = odysT;
      window.odysApply = odysApply;
      window.odysSetLang = odysSetLang;
      window.odysLang = current;

      document.addEventListener('click', (event) => {
        const root = document.getElementById('lang-switch');
        if (root && !root.contains(event.target)) closeLangMenu();
      });

      document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('lang-toggle')?.addEventListener('click', (event) => {
          event.stopPropagation();
          const list = document.getElementById('lang-list');
          const toggle = document.getElementById('lang-toggle');
          if (!list || !toggle) return;
          const willOpen = list.hidden;
          list.hidden = !willOpen;
          toggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
        });
        document.querySelectorAll('[data-lang-option]').forEach((btn) => {
          btn.addEventListener('click', () => {
            odysSetLang(btn.getAttribute('data-lang-option'));
            closeLangMenu();
          });
        });
        odysApply();
      });

      if (document.readyState !== 'loading') odysApply();
    </script>
  </body>
</html>
