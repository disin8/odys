      </a>
      <LegalTabs active="terms" />

      <div class="flex items-center gap-2 text-xs font-bold text-[#FF7A59] uppercase tracking-wider mb-2">
        <span>Effective November 18, 2026</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold mb-4">Terms of Use (EULA) for Odys Travel</h1>
