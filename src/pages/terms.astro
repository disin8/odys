          <p>
            These Terms are governed by the laws of the Republic of Lithuania, without regard to conflict-of-law rules, except where mandatory consumer-protection laws of your country of residence provide you with additional rights.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-bold text-[#221F2C] dark:text-[#F5F3FA] mb-3">17. Contact</h2>
          <p class="mb-3">
            For support, questions, or notices regarding these Terms, contact:
          </p>
          <p>
            <strong class="text-[#221F2C] dark:text-[#F5F3FA]">Dmitry Sinkevich</strong><br />
            Email: <a href="mailto:dmitry8.work@gmail.com" class="text-[#FF7A59] underline">dmitry8.work@gmail.com</a>
          </p>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
