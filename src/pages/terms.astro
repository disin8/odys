---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LegalTabs from '../components/LegalTabs.astro';
import LegalArticle from '../components/LegalArticle.astro';
import { termsDoc } from '../i18n/legal/terms';
---

<Layout titleKey="meta.terms.title" descriptionKey="meta.terms.desc">
  <Header />
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="odys-card p-8 sm:p-12">
      <a href="/odys/" class="inline-flex items-center gap-2 text-xs font-bold text-[#FF7A59] mb-6 hover:underline" data-i18n="legal.back">
        ← Back to Odys Travel
      </a>
      <LegalTabs active="terms" />
      <LegalArticle doc={termsDoc} kickerClass="text-[#FF7A59]" />
    </div>
  </main>
  <Footer />
</Layout>
