---
import Icon from './Icon.astro';
---

<section class="pt-8 pb-16 sm:pt-14 sm:pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/70 dark:bg-white/10 border border-black/5 dark:border-white/10 text-xs font-bold text-[#FF7A59] mb-6 backdrop-blur-md shadow-sm">
      <Icon name="shield-check" class="w-4 h-4 text-[#FF7A59]" />
      <span data-i18n="hero.badge">Your Travels, Your Business</span>
    </div>

    <h1
      class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.08] text-[#221F2C] dark:text-[#F5F3FA] mb-6"
      data-i18n="hero.title"
    >
      Turn your photo library into an interactive scratch map
    </h1>

    <p
      class="text-base sm:text-xl text-[#6A647E] dark:text-[#928C9D] leading-relaxed mb-8 max-w-2xl mx-auto"
      data-i18n="hero.lead"
    >
      Relive every journey, country, and city in a vivid personal atlas. 100% on-device, zero tracking, zero cloud uploads.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-4">
      <a
        href="https://apps.apple.com/us/app/odys-travel/id6830479998"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3.5 px-6 py-3.5 rounded-2xl bg-[#111111] hover:bg-black text-white shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all"
      >
        <svg class="w-7 h-7 fill-current shrink-0" viewBox="0 0 32 32">
          <g fill="currentColor">
            <path d="M19.61,4.808c1.035-1.294,1.737-3.032,1.552-4.808-1.515,.075-3.363,.999-4.433,2.295-.961,1.109-1.811,2.92-1.59,4.621,1.7,.147,3.399-.85,4.471-2.108"></path>
            <path d="M21.143,7.248c-2.469-.147-4.569,1.401-5.748,1.401s-2.986-1.327-4.939-1.292c-2.542,.037-4.901,1.475-6.191,3.761-2.653,4.573-.7,11.357,1.88,15.081,1.253,1.843,2.763,3.872,4.753,3.799,1.88-.074,2.617-1.217,4.902-1.217s2.947,1.217,4.937,1.18c2.064-.037,3.354-1.844,4.607-3.688,1.437-2.101,2.026-4.129,2.063-4.24-.037-.037-3.98-1.549-4.016-6.084-.037-3.797,3.095-5.603,3.243-5.716-1.769-2.616-4.533-2.911-5.491-2.985"></path>
          </g>
        </svg>
        <div class="text-left leading-tight">
          <div class="text-[10px] font-normal tracking-wide opacity-80" data-i18n="hero.downloadOn">Download on the</div>
          <div class="text-base font-bold">App Store</div>
        </div>
      </a>
    </div>

    <div
      class="text-xs text-[#6A647E] dark:text-[#928C9D]"
      data-i18n="hero.note"
    >
      Free download · Built for iOS 18 and later · Works completely offline
    </div>
  </div>

  <div id="screens" class="max-w-5xl mx-auto">
      <button
        type="button"
        onclick="switchScreen(0)"
        id="tab-0"
        class="screen-tab active inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer bg-[#FF7A59] text-white shadow-lg"
      >
        <span data-i18n="hero.tab0">Scratch Map</span>
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-black/20 text-white" data-i18n="hero.badge0">10 Visited</span>
      </button>
      <button
        type="button"
        onclick="switchScreen(1)"
        id="tab-1"
        class="screen-tab inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer bg-white/70 dark:bg-white/10 text-[#6A647E] dark:text-[#928C9D] hover:bg-white dark:hover:bg-white/15"
      >
        <span data-i18n="hero.tab1">Journeys & Flights</span>
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-[#8E88A4]" data-i18n="hero.badge1">2025</span>
      </button>
      <button
        type="button"
        onclick="switchScreen(2)"
        id="tab-2"
        class="screen-tab inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer bg-white/70 dark:bg-white/10 text-[#6A647E] dark:text-[#928C9D] hover:bg-white dark:hover:bg-white/15"
      >
        <span data-i18n="hero.tab2">Lifetime Stats</span>
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 text-[#8E88A4]" data-i18n="hero.badge2">4% World</span>
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 flex justify-center">
        <div class="relative w-full max-w-[310px] sm:max-w-[340px] aspect-[1508/3278] select-none filter drop-shadow-2xl">
          <div
            class="absolute overflow-hidden rounded-[11.5%] z-0"
            style="left: 10.01%; top: 10.01%; width: 79.98%; height: 79.98%;"
          >
            <img
              id="hero-screen-img"
              src="/odys/assets/aistudio/IMG_2920_51c54557.webp"
              alt="Odys Travel App Screen"
              class="w-full h-full object-cover select-none transition-opacity duration-300"
            />
          </div>

          <img
            src="/odys/assets/aistudio/deep-blue_f1a74022.webp"
            alt="iPhone Device Frame"
            class="relative z-10 w-full h-full pointer-events-none select-none drop-shadow-2xl"
          />
        </div>
      </div>

      <div class="lg:col-span-5 space-y-4">
        <div class="odys-card p-6 border transition-all">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-[#FF7A59]" data-i18n="hero.kicker">Odys iOS Feature</span>
          </div>
          <h3 id="screen-title" class="text-xl font-bold mb-2" data-i18n="hero.s0.title">Interactive Scratch Map</h3>
          <p id="screen-desc" class="text-sm text-[#6A647E] dark:text-[#928C9D] leading-relaxed" data-i18n="hero.s0.desc">
            Every country and region you visit is automatically colored on your private map directly from your photo timestamps.
          </p>
        </div>

        <div class="odys-card p-5 border flex items-center justify-between text-xs font-medium text-[#6A647E] dark:text-[#928C9D]">
          <span data-i18n="hero.theme">Theme adapted automatically</span>
          <span class="px-2.5 py-1 rounded-full bg-[#FF7A59]/10 text-[#FF7A59] font-bold" data-i18n="hero.ondevice">100% On-Device</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const screensData = [
    {
      dark: '/odys/assets/aistudio/IMG_2916_99e55772.webp',
      light: '/odys/assets/aistudio/IMG_2920_51c54557.webp',
      titleKey: 'hero.s0.title',
      descKey: 'hero.s0.desc'
    },
    {
      dark: '/odys/assets/aistudio/IMG_2918_2bcd836f.webp',
      light: '/odys/assets/aistudio/IMG_2922_69e21ad8.webp',
      titleKey: 'hero.s1.title',
      descKey: 'hero.s1.desc'
    },
    {
      dark: '/odys/assets/aistudio/IMG_2919_0f756b60.webp',
      light: '/odys/assets/aistudio/IMG_2921_c7dcf275.webp',
      titleKey: 'hero.s2.title',
      descKey: 'hero.s2.desc'
    }
  ];

  let currentScreenIdx = 0;

  function updateHeroImage() {
    const isDark = document.documentElement.classList.contains('dark');
    const screen = screensData[currentScreenIdx];
    const imgEl = document.getElementById('hero-screen-img');
    const titleEl = document.getElementById('screen-title');
    const descEl = document.getElementById('screen-desc');
    if (imgEl) {
      imgEl.src = isDark ? screen.dark : screen.light;
    }
    if (titleEl) titleEl.setAttribute('data-i18n', screen.titleKey);
    if (descEl) descEl.setAttribute('data-i18n', screen.descKey);
    window.odysApply?.();
  }

  function switchScreen(idx) {
    currentScreenIdx = idx;
    document.querySelectorAll('.screen-tab').forEach((tab, i) => {
      if (i === idx) {
        tab.className = 'screen-tab active inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer bg-[#FF7A59] text-white shadow-lg';
      } else {
        tab.className = 'screen-tab inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer bg-white/70 dark:bg-white/10 text-[#6A647E] dark:text-[#928C9D] hover:bg-white dark:hover:bg-white/15';
      }
    });
    updateHeroImage();
  }
  window.switchScreen = switchScreen;

  const observer = new MutationObserver(() => updateHeroImage());
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  updateHeroImage();
</script>
