---
import Icon from './Icon.astro';

const comparisons = [
  {
    featureEn: 'Where your photos are processed',
    featureRu: 'Где обрабатываются фотографии',
    odysEn: '100% on your iPhone',
    odysRu: '100% на вашем iPhone',
    othersEn: 'Uploaded to cloud servers',
    othersRu: 'Загружаются на чужие серверы',
  },
  {
    featureEn: 'Account & Sign-up requirement',
    featureRu: 'Требование регистрации',
    odysEn: 'Zero accounts required',
    odysRu: 'Без создания аккаунта',
    othersEn: 'Email, phone number, password',
    othersRu: 'Email, телефон или соцсети',
  },
  {
    featureEn: 'World map & city borders',
    featureRu: 'Карты и границы городов',
    odysEn: 'Bundled inside app · Offline',
    odysRu: 'Встроены в приложение · Офлайн',
    othersEn: 'Streamed over cellular data',
    othersRu: 'Подгружаются через интернет',
  },
  {
    featureEn: 'Advertising & Cross-app tracking',
    featureRu: 'Реклама и сбор аналитики',
    odysEn: 'Zero ads, zero data harvesting',
    odysRu: '0 рекламы, 0 трекеров',
    othersEn: 'Profiles sold to ad networks',
    othersRu: 'Продажа данных рекламодателям',
  },
  {
    featureEn: 'Memory Vault Security',
    featureRu: 'Защита личного дневника',
    odysEn: 'Biometric Face ID lock',
    odysRu: 'Биометрия Face ID',
    othersEn: 'Public by default',
    othersRu: 'Публичный профиль по умолчанию',
  },
];
---

<section id="privacy" class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/70 dark:bg-white/10 text-xs font-bold text-[#4ADE80] mb-4">
      <Icon name="shield-check" class="w-4 h-4" />
      <span data-lang-en="Privacy By Design" data-lang-ru="Приватность в основе">Privacy By Design</span>
    </div>
    <h2
      class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4"
      data-lang-en="Why travel tracking should stay on your phone"
      data-lang-ru="Почему история путешествий должна оставаться на телефоне"
    >
      Why travel tracking should stay on your phone
    </h2>
    <p
      class="text-base text-[#6A647E] dark:text-[#928C9D]"
      data-lang-en="Compare Odys Travel with typical cloud travel scratch apps."
      data-lang-ru="Сравните Odys Travel со стандартными облачными трекерами."
    >
      Compare Odys Travel with typical cloud travel scratch apps.
    </p>
  </div>

  <div class="odys-card overflow-hidden border">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse table-fixed">
        <colgroup>
          <col class="w-2/5 sm:w-1/3" />
          <col class="w-3/10 sm:w-1/3" />
          <col class="w-3/10 sm:w-1/3" />
        </colgroup>
        <thead>
          <tr class="border-b border-black/5 dark:border-white/5 bg-black/[0.02] dark:bg-white/[0.02]">
            <th class="p-4 sm:p-6 text-xs sm:text-sm font-bold text-[#6A647E] dark:text-[#928C9D]" data-lang-en="Capability" data-lang-ru="Возможность">
              Capability
            </th>
            <th class="p-4 sm:p-6 text-xs sm:text-sm font-extrabold text-[#FF7A59] bg-[#FF7A59]/5">
              <div class="flex items-center gap-1.5">
                <span>Odys Travel</span>
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#FF7A59] text-white">You</span>
              </div>
            </th>
            <th class="p-4 sm:p-6 text-xs sm:text-sm font-bold text-[#6A647E] dark:text-[#928C9D]" data-lang-en="Typical Cloud Apps" data-lang-ru="Обычные приложения">
              Typical Cloud Apps
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-black/5 dark:divide-white/5 text-xs sm:text-sm">
          {comparisons.map((row) => (
            <tr class="hover:bg-black/[0.01] dark:hover:bg-white/[0.01] transition-colors">
              <td class="p-4 sm:p-6 font-semibold text-[#221F2C] dark:text-[#F5F3FA]">
                <span data-lang-en={row.featureEn} data-lang-ru={row.featureRu}>{row.featureEn}</span>
              </td>
              <td class="p-4 sm:p-6 bg-[#FF7A59]/5 font-bold text-[#221F2C] dark:text-white">
                <div class="flex items-center gap-2 text-[#4ADE80]">
                  <Icon name="check" class="w-4 h-4 shrink-0 text-[#4ADE80]" />
                  <span class="text-[#221F2C] dark:text-white" data-lang-en={row.odysEn} data-lang-ru={row.odysRu}>{row.odysEn}</span>
                </div>
              </td>
              <td class="p-4 sm:p-6 text-[#6A647E] dark:text-[#928C9D]">
                <div class="flex items-center gap-2">
                  <Icon name="xmark" class="w-4 h-4 shrink-0 text-red-400" />
                  <span data-lang-en={row.othersEn} data-lang-ru={row.othersRu}>{row.othersEn}</span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="p-5 sm:p-6 bg-black/[0.02] dark:bg-white/[0.02] border-t border-black/5 dark:border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <span class="text-[#6A647E] dark:text-[#928C9D]" data-lang-en="Read our complete App Store compliant policies" data-lang-ru="Ознакомьтесь с полными юридическими документами для App Store">
        Read our complete App Store compliant policies
      </span>
      <div class="flex items-center gap-3">
        <a href="/odys/privacy/" class="font-bold text-[#FF7A59] hover:underline" data-lang-en="Privacy Policy →" data-lang-ru="Политика приватности →">
          Privacy Policy →
        </a>
        <span class="opacity-30">·</span>
        <a href="/odys/terms/" class="font-bold text-[#FF7A59] hover:underline" data-lang-en="Terms of Use (EULA) →" data-lang-ru="Условия использования →">
          Terms of Use (EULA) →
        </a>
      </div>
    </div>
  </div>
</section>
