---
import Icon from './Icon.astro';
---

<header class="sticky top-4 z-40 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="odys-pill px-5 sm:px-7 py-3 flex items-center justify-between gap-6 sm:gap-8 transition-all duration-300 backdrop-blur-2xl">
    <a
      href="/odys/"
      class="flex items-center gap-2.5 text-base sm:text-lg font-extrabold tracking-[0.2em] text-[#FF7A59] whitespace-nowrap shrink-0 hover:opacity-90 transition-opacity"
    >
      <img
        src="/odys/assets/images/app-icon.png"
        alt="Odys Bear"
        class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg shadow-sm"
      />
      <span>ODYS</span>
    </a>

    <nav class="hidden md:flex items-center gap-7 text-xs font-semibold text-[#6A647E] dark:text-[#928C9D]">
      <a
        href="/odys/#screens"
        class="hover:text-[#221F2C] dark:hover:text-white transition-colors whitespace-nowrap shrink-0"
        data-lang-en="Screens"
        data-lang-ru="Экраны"
      >
        Screens
      </a>
      <a
        href="/odys/#features"
        class="hover:text-[#221F2C] dark:hover:text-white transition-colors whitespace-nowrap shrink-0"
        data-lang-en="Features"
        data-lang-ru="Возможности"
      >
        Features
      </a>
      <a
        href="/odys/#mascots"
        class="hover:text-[#221F2C] dark:hover:text-white transition-colors whitespace-nowrap shrink-0"
        data-lang-en="Companions"
        data-lang-ru="Спутники"
      >
        Companions
      </a>
      <a
        href="/odys/#privacy"
        class="hover:text-[#221F2C] dark:hover:text-white transition-colors whitespace-nowrap shrink-0"
        data-lang-en="Privacy"
        data-lang-ru="Приватность"
      >
        Privacy
      </a>
      <a
        href="/odys/privacy/"
        class="hover:text-[#221F2C] dark:hover:text-white transition-colors whitespace-nowrap shrink-0"
        data-lang-en="Legal & EULA"
        data-lang-ru="Документы"
      >
        Legal & EULA
      </a>
    </nav>

    <div class="flex items-center gap-2.5 shrink-0">
      <button
        type="button"
        onclick="window.toggleLang()"
        class="p-1.5 rounded-xl hover:bg-black/5 dark:hover:bg-white/10 text-xs font-bold text-[#6A647E] dark:text-[#928C9D] transition-colors flex items-center gap-1 cursor-pointer"
        title="Toggle EN / RU"
      >
        <Icon name="language" class="w-3.5 h-3.5" />
        <span id="lang-label" class="uppercase">EN</span>
      </button>

      <button
        type="button"
        onclick="window.toggleTheme()"
        class="p-1.5 rounded-xl hover:bg-black/5 dark:hover:bg-white/10 text-[#6A647E] dark:text-[#928C9D] transition-colors cursor-pointer"
        title="Toggle Dark / Light Theme"
        aria-label="Toggle theme"
      >
        <Icon name="sun" class="w-4 h-4 hidden dark:block text-[#FFA07A]" />
        <Icon name="moon" class="w-4 h-4 block dark:hidden text-[#A78BFA]" />
      </button>

      <a
        href="https://apps.apple.com/us/app/odys-travel/id6830479998"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#FF7A59] hover:bg-[#FF6740] text-white font-bold text-xs shadow-md hover:scale-[1.02] active:scale-[0.98] transition-all whitespace-nowrap shrink-0"
      >
        <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 32 32">
          <g fill="currentColor">
            <path d="M19.61,4.808c1.035-1.294,1.737-3.032,1.552-4.808-1.515,.075-3.363,.999-4.433,2.295-.961,1.109-1.811,2.92-1.59,4.621,1.7,.147,3.399-.85,4.471-2.108"></path>
            <path d="M21.143,7.248c-2.469-.147-4.569,1.401-5.748,1.401s-2.986-1.327-4.939-1.292c-2.542,.037-4.901,1.475-6.191,3.761-2.653,4.573-.7,11.357,1.88,15.081,1.253,1.843,2.763,3.872,4.753,3.799,1.88-.074,2.617-1.217,4.902-1.217s2.947,1.217,4.937,1.18c2.064-.037,3.354-1.844,4.607-3.688,1.437-2.101,2.026-4.129,2.063-4.24-.037-.037-3.98-1.549-4.016-6.084-.037-3.797,3.095-5.603,3.243-5.716-1.769-2.616-4.533-2.911-5.491-2.985"></path>
          </g>
        </svg>
        <span data-lang-en="Download App" data-lang-ru="Скачать">Download App</span>
      </a>
    </div>
  </div>
</header>
